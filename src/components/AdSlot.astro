---
// Anzeigenplatz. Sobald eine AdSense-Publisher-ID gesetzt ist
// (PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXX), wird der echte Slot gerendert.
// Ohne ID bleibt der Platz im Entwicklungsmodus als Platzhalter sichtbar,
// im Produktions-Build wird nichts gerendert (kein leerer Kasten).
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const slot = import.meta.env.PUBLIC_ADSENSE_SLOT ?? '';
const showPlaceholder = import.meta.env.DEV && !client;
---

{client ? (
  <div class="ad" data-ad-slot>
    <span class="ad__label">Anzeige</span>
    <ins
      class="adsbygoogle"
      style="display:block;width:100%"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"></ins>
  </div>
) : showPlaceholder ? (
  <div class="ad" aria-hidden="true">
    <span class="ad__label">Anzeige</span>
  </div>
) : null}
