---
import { tools, guides, SITE } from '../data/tools';

const year = new Date().getFullYear();
// Der Widerrufslink gehört zum Einwilligungsbanner. Ohne eingebundene Werbung
// gibt es nichts zu widerrufen – ein Knopf ohne Funktion ist schlechter als keiner.
const adsEnabled = Boolean(import.meta.env.PUBLIC_ADSENSE_CLIENT);
// Endung nur zeigen, wenn sie auch wirklich ausgeliefert wird (siehe Header).
const [brandName, brandTld] = SITE.domain ? SITE.domain.split(/\.(?=[^.]+$)/) : [SITE.name, null];
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__col footer__about">
        <a class="brand" href="/">
          <span class="brand__mark">◆</span>
          <span>{brandName}{brandTld && <span class="brand__tld">.{brandTld}</span>}</span>
        </a>
        <p class="mt-2">
          Kostenlose Bildwerkzeuge, die vollständig in deinem Browser laufen. Deine Bilder werden
          nicht hochgeladen und nicht gespeichert.
        </p>
      </div>

      <div class="footer__col">
        <h3>Werkzeuge</h3>
        <ul>
          {tools.map(tool => (
            <li><a href={tool.href}>{tool.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <h3>Ratgeber</h3>
        <ul>
          <li><a href="/bildschutz/">Bildschutz</a></li>
          {guides.map(guide => (
            <li><a href={guide.href}>{guide.title}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer__col">
        <h3>Rechtliches</h3>
        <ul>
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
          {adsEnabled && (
            <li>
              <button type="button" class="footer__consent" data-open-consent>
                Cookie-Einstellungen
              </button>
            </li>
          )}
          <li><a href="/ueber-uns/">Über uns</a></li>
          <li><a href="/kontakt/">Kontakt</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} {SITE.name} – Alle Werkzeuge laufen lokal in deinem Browser.</span>
      <span>
        Design-Komponenten: <a href="https://reactbits.dev" rel="noopener nofollow" target="_blank">React Bits</a>
        (MIT + Commons Clause)
      </span>
    </div>
  </div>
</footer>

<style>
  .footer__about .brand__mark {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: var(--brand-grad);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 12px;
  }

  /* Widerruf der Einwilligung: sieht aus wie ein Link, ist aber ein Button,
     damit die Aktion ohne JavaScript-freie Alternative nicht als Link zählt. */
  .footer__consent {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 0.92rem;
    color: var(--ink-soft);
    cursor: pointer;
    text-align: left;
  }

  .footer__consent:hover {
    color: var(--brand-ink);
  }

  .footer__consent:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
    border-radius: 4px;
  }
</style>
