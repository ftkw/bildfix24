# Cloudflare-Pages-Header. Wird beim Deploy aus public/ ins dist-Root kopiert.
# Bei einem Wechsel des Hosters muss das Pendant (_headers / netlify.toml /
# .htaccess) mitgenommen werden – sonst fehlen Security-Header und Caching.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Astro hängt an jede Datei einen Content-Hash – sie kann dauerhaft gecacht werden.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Die Startseite muss kurzfristig aktualisierbar bleiben.
/
  Cache-Control: public, max-age=0, must-revalidate

/og.png
  Cache-Control: public, max-age=86400

# Die Sitemap ist die eine Datei, die Google nicht abrufen konnte, obwohl
# robots.txt im selben Verzeichnis einwandfrei geholt wurde. Ausgeschlossen
# sind damit: DNS, Domain und Bot-Sperre. Übrig bleibt, dass die Auslieferung
# selbst etwas tut, was der Parser nicht erwartet. `no-transform` ist die
# einzige standardisierte Möglichkeit, Zwischenschichten zu untersagen, den
# Rumpf zu verändern; zusammen mit einer festen Deklaration von Typ und
# Zeichensatz ist das die billigste Gegenprobe. Ohne Wirkung auf den Inhalt.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate, no-transform
